+std::string HloValueSemantics::ToString() const {
+  std::string content = absl::StrJoin(
+      {absl::StrCat("label: ", HloValueSemanticLabelToString(label_)),
+       absl::StrCat("origin: ", origin_.ToString())},
+      ", ");
