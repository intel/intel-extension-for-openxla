 #define XLA_SERVICE_HLO_ORDERING_H_
 
-// The current header will be deprecated in favour of the following.
-#include "xla/hlo/analysis/hlo_ordering.h"
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "absl/container/flat_hash_map.h"
