+void GpuSolverContext::Deleter::operator()(gpusolverHandle_t handle) {
+  if (handle) {
+    absl::Status status = ConvertStatus(GpuSolverDestroy(handle));
+    if (!status.ok()) {
+      LOG(ERROR) << "GpuSolverDestroy failed: " << status;
+    }
+  }
