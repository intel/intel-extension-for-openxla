+// This file implements logic for simplifying HLO dot.
+
+#include <memory>
+#include <utility>
+
+#include "mhlo/IR/hlo_ops.h"
+#include "mhlo/transforms/passes.h"
+#include "mlir/Dialect/Func/IR/FuncOps.h"
