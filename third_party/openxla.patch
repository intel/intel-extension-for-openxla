+absl::StatusOr<hipError_t> QueryEvent(GpuContext* context, hipEvent_t event) {
+  ScopedActivateContext activated{context};
+  hipError_t res = wrap::hipEventQuery(event);
+  if (res != hipSuccess && res != hipErrorNotReady) {
+    return absl::Status{
