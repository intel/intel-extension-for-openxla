+  return parser.ParseWindowOnly();
+}
+
+absl::StatusOr<ConvolutionDimensionNumbers> ParseConvolutionDimensionNumbers(
+    absl::string_view str) {
+  HloParserImpl parser(str);
+  return parser.ParseConvolutionDimensionNumbersOnly();
+}
+
