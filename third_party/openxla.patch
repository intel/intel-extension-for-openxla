+/* static */ absl::StatusOr<CUdevice> GpuDriver::DeviceFromContext(
+    GpuContext* context) {
+  ScopedActivateContext activated{context};
+  CUdevice device = -1;
+  CUresult result = cuCtxGetDevice(&device);
