+// Creates an `OpMetadata` with the debug name from the `value`'s
+// `mlir::Location`.
+xla::OpMetadata GetOpNameMetadataFromLocation(Value value) {
+  xla::OpMetadata m;
+  m.set_op_name(mhlo::GetDebugNameFromLocation(value.getLoc()));
+  return m;
