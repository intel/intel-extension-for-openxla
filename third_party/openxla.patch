index 0000000000..5b6ac2104b
--- /dev/null
+++ b/xla/translate/mhlo_to_hlo/operator_writer_gen.cc
@@ -0,0 +1,201 @@
+/* Copyright 2019 The OpenXLA Authors.
+
+Licensed under the Apache License, Version 2.0 (the "License");
