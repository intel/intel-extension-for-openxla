+// This file implements logic for lowering HLO/LHLO dialect to scalar shape
+// operations.
+
+#include <algorithm>
+#include <memory>
+#include <numeric>
+#include <string>
+#include <utility>
+
+#include "llvm/ADT/STLExtras.h"
