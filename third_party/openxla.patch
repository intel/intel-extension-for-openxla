+ protected:
+  friend class HloValueSemanticsPropagation;
+  explicit HloValueSemanticsAnalysis(
+      const HloModule& module,
+      const absl::flat_hash_set<std::string_view>& execution_threads);
+  virtual absl::Status InitializeEinsumDepth();
