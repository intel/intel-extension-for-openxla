+namespace mlir {
+class StackFrameIndexBuilder {
+ public:
+  constexpr static int kInvalidIndex = 0;
+
+  xla::StackFrameIndexProto Build() const;
+
+  struct AddStackFrameResult {
+    int last_frame_id;
+    std::string last_frame_file;
