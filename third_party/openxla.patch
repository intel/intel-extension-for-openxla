diff --git a/xla/service/logical_buffer_analysis.cc b/xla/service/logical_buffer_analysis.cc
new file mode 100644
index 0000000000..916bc800ae
--- /dev/null
+++ b/xla/service/logical_buffer_analysis.cc
@@ -0,0 +1,227 @@
+/* Copyright 2017 The OpenXLA Authors.
+
+Licensed under the Apache License, Version 2.0 (the "License");
