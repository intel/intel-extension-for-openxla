+static void AppendArgsFromOptions(GpuAsmOpts options,
+                                  std::vector<std::string>& args) {
+  if (options.disable_gpuasm_optimizations) {
+    args.push_back("-O0");
+  }
+  args.insert(args.end(), options.extra_flags.begin(),
+              options.extra_flags.end());
+}
