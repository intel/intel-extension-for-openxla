+  auto result = computation_pool_.insert({name, {computation, name_loc}});
+  if (!result.second) {
+    Error(name_loc, StrCat("computation already exists: ", name));
+    return Error(/*loc=*/result.first->second.second,
+                 "computation previously defined here");
+  }
+  return true;
+}
