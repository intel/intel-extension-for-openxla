+  xla::Shape& shape = shape_or.value();
+  if (!shape.IsTuple()) {
+    value_map[op.getResult(0)] = sorted;
+    return success();
+  }
+
+  // MLIR's sort supports multiple returns, untuple all the results of XLA's.
+  BuildGetTupleElementsForTupleResults(op, sorted, ctx);
+  return success();
+}
