+absl::StatusOr<GpuSolverContext> GpuSolverContext::Create() {
+  gpusolverHandle_t handle;
+  TF_RETURN_IF_ERROR(ConvertStatus(GpuSolverCreate(&handle)));
+  return GpuSolverContext(handle);
