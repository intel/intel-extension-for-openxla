+    if (option.allow_mixed_mesh_shape) {
+      option.allow_mixed_mesh_shape = false;
+      LOG(WARNING)
+          << "Mixed mesh shape is disabled due to indivisible batch size.";
+    }
+  }
+
+  if (batch_size == 1) {
+    option.force_batch_dim_to_mesh_dim = -1;
+  }
