+bool HloParserImpl::ParseBool(bool* result) {
+  if (lexer_.GetKind() != TokKind::kw_true &&
+      lexer_.GetKind() != TokKind::kw_false) {
+    return TokenError("expects true or false");
+  }
+  *result = lexer_.GetKind() == TokKind::kw_true;
+  lexer_.Lex();
+  return true;
+}
