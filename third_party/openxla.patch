+// CUDA/ROCm userspace driver library wrapper functionality.
+
+#ifndef XLA_STREAM_EXECUTOR_GPU_GPU_DRIVER_H_
+#define XLA_STREAM_EXECUTOR_GPU_GPU_DRIVER_H_
+
+#include <stddef.h>
+
+#include <cstdint>
+#include <string>
+#include <utility>
