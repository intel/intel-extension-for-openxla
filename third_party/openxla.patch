-float RuntimeSimulator::ProcessAsyncCopyLikesInIdleTime(float time) {
-  if (time <= 0.0) {
-    return 0.0;
-  }
-
-  double available_bandwidth =
-      cost_analysis_->DefaultMemBandwidthBytesPerSecond();
-
-  float remaining_simulation_time = time;
