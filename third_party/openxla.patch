+int64_t NumAddedParameters(const HloInstruction& hlo) {
+  // Non-scalar constant is equivalent to a parameter: one input, one output.
+  if (hlo.opcode() == HloOpcode::kConstant &&
+      !ShapeUtil::IsScalar(hlo.shape())) {
+    return 0;
