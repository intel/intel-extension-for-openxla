+  LogicalResult matchAndRewrite(
+      SyncThreadsOp op, mlir::PatternRewriter& rewriter) const override {
+    rewriter.create<mlir::gpu::BarrierOp>(op.getLoc());
+    rewriter.replaceOp(op, op.getOperands());
